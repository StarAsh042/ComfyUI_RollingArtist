# Comfy Registry 发布包排除项（.comfyignore）
# node.zip 只含运行所需文件；运行期资源一律保留：
#   节点 .py、ra_core/、locales/（nodeDefs.json 前端文案）、
#   web/docs/（信息面板帮助页，RollingArtist.py 明示依赖）、
#   danbooru_art_001.csv / danbooru_character_001.csv（默认数据）

# 测试：运行期不需要，排除可缩小发布物体积与安全扫描面
tests/

# 项目文档（数据 SOP / 决策记录 / 迭代计划）：与 tests/ 同策，本地独享。
# 必须前导 / 锚定仓库根：无锚定的 docs/ 会按 gitwildmatch 语义把
# web/docs/（运行期信息面板，见上方保留清单）一并排除。
/docs/

# CHANGELOG：非运行期文件，且历史段落引用标准库 API 名称（sqlite3
# 连接工厂、environ 读取、INSERT 排版等）会被 Registry 安全扫描器按
# 字面量命中——5.1.5 实测 7 条 finding 中 6 条源自 CHANGELOG 与
# ITERATION_PLAN 文档，排除文档从根上收敛扫描面（Registry 页面
# changelog 字段本就为空字符串，排除无展示损失）。
/CHANGELOG.md

# CI 与本地开发配置
.github/
.pre-commit-config.yaml
web/docs/_build_report_html.py

# 数据加工原料（Git LFS 指针文件，非运行期数据；运行期使用 *_001.csv）
danbooru_art_full.csv
danbooru_character.csv
